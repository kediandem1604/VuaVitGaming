# Web
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# DEV_LOGIN=1 chỉ có tác dụng khi PUBLIC_URL bắt đầu bằng http://localhost
DEV_LOGIN=0
# Số lớp proxy phía trước app (Railway thường là 1) — để lấy đúng IP người dùng cho giới hạn tốc độ
TRUST_PROXY_HOPS=1

# PostgreSQL nhúng (npm run db:start)
DATABASE_URL=postgresql://ggd:ggd@localhost:54329/ggd_dev

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_SCHEDULE_CHANNEL_ID=
DISCORD_VOTE_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Danh sách ID role, phân tách bằng dấu phẩy
DISCORD_ADMIN_ROLE_IDS=
DISCORD_MOD_ROLE_IDS=

# Email — có BREVO_API_KEY thì gửi qua API HTTPS của Brevo (bắt buộc trên Railway gói
# Free/Hobby vì Railway chặn SMTP) và các biến SMTP_* bị bỏ qua. MAIL_FROM luôn cần;
# dùng Brevo thì phải là địa chỉ người gửi đã xác minh trong Brevo.
BREVO_API_KEY=

# Email qua SMTP (vd Gmail + mật khẩu ứng dụng) — chỉ dùng khi không đặt BREVO_API_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GGD Hub <ban@gmail.com>
