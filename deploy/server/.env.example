# Cấu hình GGD Hub trên máy chủ Ubuntu. setup.sh chép file này thành .env và tự điền
# SITE_ADDRESS, POSTGRES_PASSWORD, SESSION_SECRET. Bạn chỉ điền phần Discord và email
# (README mục 2–4). File .env chứa bí mật: không gửi cho ai, không commit.

# --- setup.sh tự điền ---
# Địa chỉ web (không có https://): <IP-tĩnh-gạch-ngang>.sslip.io (HTTPS miễn phí, không cần
# mua tên miền) hoặc tên miền riêng đã trỏ về IP tĩnh của máy. PUBLIC_URL của ứng dụng
# = https://SITE_ADDRESS (docker-compose.yml tự ghép).
SITE_ADDRESS=
POSTGRES_PASSWORD=
SESSION_SECRET=

# Một lớp proxy (Caddy) đứng trước ứng dụng.
TRUST_PROXY_HOPS=1

# --- Bạn điền ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_SCHEDULE_CHANNEL_ID=
DISCORD_VOTE_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Danh sách ID role, phân tách bằng dấu phẩy
DISCORD_ADMIN_ROLE_IDS=
DISCORD_MOD_ROLE_IDS=

# Email nhắc giờ qua Brevo (README mục 4.1). MAIL_FROM là người gửi đã xác minh trong Brevo.
BREVO_API_KEY=
MAIL_FROM=GGD Hub <ban@gmail.com>
