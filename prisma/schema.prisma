generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccessLevel {
  member
  mod
  admin
}

enum MemberStatus {
  active
  left
}

enum SessionStatus {
  scheduled
  ended
  cancelled
}

enum AttendanceStatus {
  going
  cancelled
}

enum ReminderKind {
  pre15
  start
}

enum Channel {
  email
  dm
}

enum CategoryScope {
  always
  mode
  optional
}

enum RoundStatus {
  open
  closed
}

enum Faction {
  goose
  duck
  neutral
}

enum ReportStatus {
  pending
  approved
  rejected
  /// Bị huỷ duyệt: chỉ từ `approved`, trạng thái cuối; CHECK bắt đủ `revoked_by`, `revoked_at`, `reject_reason`.
  revoked
}

/// Nguồn một lần khai: `self` do chính người chơi khai; `accusation` là mục trừ điểm tạo khi một
/// báo cáo người chơi được duyệt đúng (spec điểm role §6). `games` trên bảng role chỉ đếm `self`.
enum ReportSource {
  self
  accusation
}

/// Trạng thái một báo cáo người chơi (spec điểm role §6): `superseded` khi báo cáo trùng khác của
/// cùng vụ đã được duyệt trước; `revoked` = báo cáo độc lập bị huỷ duyệt (chỉ từ `approved`, trạng thái
/// cuối; CHECK bắt đủ người huỷ, giờ huỷ và lý do).
enum AccusationStatus {
  pending
  approved
  rejected
  superseded
  revoked
}

/// Trạng thái một lần nhận treo thưởng (spec treo thưởng §3–4) — giống lần khai: `revoked` chỉ từ
/// `approved`, trạng thái cuối; CHECK bắt đủ người huỷ, giờ huỷ và lý do.
enum BountyClaimStatus {
  pending
  approved
  rejected
  revoked
}

/// Nơi người chơi bấm nhận treo thưởng.
enum BountyClaimSource {
  web
  discord
}

/// Nhóm hạng mục tri ân tính cho danh hiệu tháng: `mvp` (Khen → SMVP), `fun` (Vui → Vua tấu hài), `none` (không tính).
enum BadgeGroup {
  mvp
  fun
  none
}

// ---------------------------------------------------------------------------
// Thành viên và đăng nhập
// ---------------------------------------------------------------------------

model Member {
  id          Int          @id @default(autoincrement())
  discordId   String       @unique @map("discord_id")
  memberCode  String       @unique @map("member_code")
  displayName String       @map("display_name")
  avatarUrl   String?      @map("avatar_url")
  email       String?
  notifyEmail Boolean      @default(true) @map("notify_email")
  notifyDm    Boolean      @default(true) @map("notify_dm")
  accessLevel AccessLevel  @default(member) @map("access_level")
  status      MemberStatus @default(active)
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt      DateTime?    @map("left_at") @db.Timestamptz(3)
  /// Ngày vào server theo Discord; null khi Discord không cho biết (ngày vào hiệu lực lùi về `joinedAt`).
  guildJoinedAt DateTime? @map("guild_joined_at") @db.Timestamptz(3)
  /// Phần admin chỉnh cộng vào số buổi tự đếm (điểm danh `going` ở buổi `ended`); có thể âm.
  gamesAdjustment Int @default(0) @map("games_adjustment")

  webSessions     WebSession[]
  createdSessions GameSession[]     @relation("SessionCreator")
  attendances     Attendance[]
  notifications   NotificationLog[]
  votesCast       Vote[]            @relation("VoteVoter")
  votesReceived   Vote[]            @relation("VoteNominee")
  awards          Award[]
  statReports     StatReport[]      @relation("ReportMember")
  reviewedReports StatReport[]      @relation("ReportReviewer")
  revokedReports  StatReport[]      @relation("ReportRevoker")
  roleTitles      RoleTitle[]
  badges          MemberBadge[]
  accusationsMade     PlayerAccusation[] @relation("AccusationReporter")
  accusationsReceived PlayerAccusation[] @relation("AccusationAccused")
  accusationsAsVictim PlayerAccusation[] @relation("AccusationVictim")
  accusationsReviewed PlayerAccusation[] @relation("AccusationReviewer")
  accusationsRevoked  PlayerAccusation[] @relation("AccusationRevoker")
  bountiesCreated      Bounty[]      @relation("BountyCreator")
  bountyClaims         BountyClaim[] @relation("BountyClaimMember")
  bountyClaimsReviewed BountyClaim[] @relation("BountyClaimReviewer")
  bountyClaimsRevoked  BountyClaim[] @relation("BountyClaimRevoker")
  multiplierDays       ScoreMultiplierDay[]

  @@map("members")
}

model WebSession {
  id        String   @id @default(uuid())
  memberId  Int      @map("member_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  member Member @relation(fields: [memberId], references: [id])

  @@map("web_sessions")
}

// ---------------------------------------------------------------------------
// Buổi chơi, điểm danh, nhắc giờ
// ---------------------------------------------------------------------------

model GameMode {
  id     Int     @id @default(autoincrement())
  key    String  @unique
  nameVi String  @map("name_vi")
  nameEn String  @map("name_en")
  active Boolean @default(true)

  sessions        GameSession[]
  roles           Role[]
  awardCategories AwardCategory[]

  @@map("game_modes")
}

model GameSession {
  id               Int           @id @default(autoincrement())
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  modeId           Int           @map("mode_id")
  capacity         Int           @default(16)
  roomCode         String?       @map("room_code")
  note             String?
  status           SessionStatus @default(scheduled)
  discordMessageId String?       @map("discord_message_id")
  discordDirty     Boolean       @default(false) @map("discord_dirty")
  createdById      Int           @map("created_by")
  endedAt          DateTime?     @map("ended_at") @db.Timestamptz(3)
  /// Tin treo thưởng của buổi trong `#treo-thưởng` (kênh + id tin); cờ `bountyDirty` = tin cần đăng/sửa bù.
  bountyChannelId  String?       @map("bounty_channel_id")
  bountyMessageId  String?       @map("bounty_message_id")
  bountyDirty      Boolean       @default(false) @map("bounty_dirty")

  mode          GameMode          @relation(fields: [modeId], references: [id])
  createdBy     Member            @relation("SessionCreator", fields: [createdById], references: [id])
  attendances   Attendance[]
  notifications NotificationLog[]
  voteRound     VoteRound?
  statReports   StatReport[]
  bounties      Bounty[]
  bountyClaims  BountyClaim[]
  accusations   PlayerAccusation[]

  @@index([startsAt])
  @@map("game_sessions")
}

model Attendance {
  sessionId Int              @map("session_id")
  memberId  Int              @map("member_id")
  status    AttendanceStatus @default(going)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session GameSession @relation(fields: [sessionId], references: [id])
  member  Member      @relation(fields: [memberId], references: [id])

  @@id([sessionId, memberId])
  @@map("attendances")
}

model NotificationLog {
  sessionId Int          @map("session_id")
  memberId  Int          @map("member_id")
  kind      ReminderKind
  channel   Channel
  sentAt    DateTime     @default(now()) @map("sent_at") @db.Timestamptz(3)
  error     String?

  session GameSession @relation(fields: [sessionId], references: [id])
  member  Member      @relation(fields: [memberId], references: [id])

  @@id([sessionId, memberId, kind, channel])
  @@map("notification_log")
}

// ---------------------------------------------------------------------------
// MVP / Sảnh tri ân
// ---------------------------------------------------------------------------

model AwardCategory {
  id          Int           @id @default(autoincrement())
  scope       CategoryScope
  modeId      Int?          @map("mode_id")
  name        String
  description String?
  active      Boolean       @default(true)
  sortOrder   Int           @map("sort_order")
  /// Tính cho danh hiệu tháng nào (spec huy hiệu §4); luôn đọc giá trị hiện tại lúc trao.
  badgeGroup  BadgeGroup    @default(none) @map("badge_group")

  mode         GameMode?     @relation(fields: [modeId], references: [id])
  voteMessages VoteMessage[]
  votes        Vote[]
  awards       Award[]

  @@map("award_categories")
}

model VoteRound {
  id        Int         @id @default(autoincrement())
  sessionId Int         @unique @map("session_id")
  opensAt   DateTime    @default(now()) @map("opens_at") @db.Timestamptz(3)
  closesAt  DateTime    @map("closes_at") @db.Timestamptz(3)
  status    RoundStatus @default(open)
  /// Đã đóng nhưng chưa đăng được kết quả vào kênh thông báo — bộ hẹn giờ đăng bù.
  announcePending Boolean @default(false) @map("announce_pending")

  session  GameSession   @relation(fields: [sessionId], references: [id])
  messages VoteMessage[]
  votes    Vote[]
  awards   Award[]

  @@index([status, closesAt])
  @@map("vote_rounds")
}

model VoteMessage {
  roundId          Int     @map("round_id")
  categoryId       Int     @map("category_id")
  discordMessageId String? @map("discord_message_id")
  /// Đợt đã đóng nhưng tin này chưa được sửa thành kết quả — bộ hẹn giờ sửa bù.
  resultPending    Boolean @default(false) @map("result_pending")

  round    VoteRound     @relation(fields: [roundId], references: [id])
  category AwardCategory @relation(fields: [categoryId], references: [id])

  @@id([roundId, categoryId])
  @@map("vote_messages")
}

model Vote {
  roundId    Int      @map("round_id")
  categoryId Int      @map("category_id")
  voterId    Int      @map("voter_id")
  nomineeId  Int      @map("nominee_id")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  round    VoteRound     @relation(fields: [roundId], references: [id])
  category AwardCategory @relation(fields: [categoryId], references: [id])
  voter    Member        @relation("VoteVoter", fields: [voterId], references: [id])
  nominee  Member        @relation("VoteNominee", fields: [nomineeId], references: [id])

  @@id([roundId, categoryId, voterId])
  @@map("votes")
}

model Award {
  roundId    Int @map("round_id")
  categoryId Int @map("category_id")
  memberId   Int @map("member_id")
  voteCount  Int @map("vote_count")

  round    VoteRound     @relation(fields: [roundId], references: [id])
  category AwardCategory @relation(fields: [categoryId], references: [id])
  member   Member        @relation(fields: [memberId], references: [id])

  @@id([roundId, categoryId, memberId])
  @@map("awards")
}

// ---------------------------------------------------------------------------
// Role, điểm, mùa giải
// ---------------------------------------------------------------------------

model Role {
  id               Int     @id @default(autoincrement())
  key              String  @unique
  faction          Faction
  nameEn           String  @map("name_en")
  nameVi           String  @map("name_vi")
  description      String
  metricLabel      String  @map("metric_label")
  maxPerGame       Int     @map("max_per_game")
  /// Điểm mỗi đơn vị chỉ số chính (spec điểm role §3), 1–100 (CHECK roles_points_range); thay luật ×5 cũ.
  points           Int     @default(1)
  /// Chỉ số phụ tuỳ chọn (spec chỉ số phụ §3–4): mỗi đơn vị `extraValue` của lần khai
  /// được `extraPoints` điểm. Ba cột cùng null hoặc cùng có (CHECK roles_extra_metric_all_or_none).
  extraMetricLabel String? @map("extra_metric_label")
  extraMaxPerGame  Int?    @map("extra_max_per_game")
  extraPoints      Int?    @map("extra_points")
  /// Chỉ số phạt tuỳ chọn (spec điểm role §3–4): mỗi đơn vị `penaltyValue` của lần khai bị TRỪ
  /// `penaltyPoints` điểm (1–100, CHECK roles_penalty_points_range). Ba cột cùng null hoặc cùng có
  /// (CHECK roles_penalty_metric_all_or_none).
  penaltyMetricLabel String? @map("penalty_metric_label")
  penaltyMaxPerGame  Int?    @map("penalty_max_per_game")
  penaltyPoints      Int?    @map("penalty_points")
  mapNote          String? @map("map_note")
  modeId           Int?    @map("mode_id")
  icon             String
  image            Bytes?
  imageMime        String? @map("image_mime")
  active           Boolean @default(true)
  sortOrder        Int     @map("sort_order")

  mode        GameMode?    @relation(fields: [modeId], references: [id])
  statReports StatReport[]
  roleTitles  RoleTitle[]
  accusations PlayerAccusation[]
  bounties     Bounty[]
  bountyClaims BountyClaim[]

  @@map("roles")
}

model StatReport {
  id           Int          @id @default(autoincrement())
  memberId     Int          @map("member_id")
  roleId       Int          @map("role_id")
  sessionId    Int?         @map("session_id")
  playedOn     DateTime     @map("played_on") @db.Date
  value        Int
  /// Giá trị chỉ số phụ của role (0 khi role không có chỉ số phụ); CHECK extra_value >= 0.
  extraValue   Int          @default(0) @map("extra_value")
  /// Giá trị chỉ số phạt của role (0 khi role không có); CHECK penalty_value >= 0. Bị TRỪ `penaltyPoints` mỗi đơn vị.
  penaltyValue Int          @default(0) @map("penalty_value")
  /// +1 khi báo cáo kèm lần khai này được duyệt đúng (spec điểm role §6); CHECK 0..1.
  bonusPoints  Int          @default(0) @map("bonus_points")
  /// `self` do người chơi khai; `accusation` là mục trừ điểm tạo khi duyệt báo cáo (không đếm vào `games`).
  source       ReportSource @default(self)
  note         String?
  status       ReportStatus @default(pending)
  reviewedById Int?         @map("reviewed_by")
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  /// Lý do từ chối hoặc huỷ duyệt (bắt buộc ở cả hai trạng thái).
  rejectReason String?      @map("reject_reason")
  /// Ai huỷ duyệt và lúc nào; `reviewedById`/`reviewedAt` (người duyệt ban đầu) giữ nguyên khi huỷ.
  revokedById  Int?         @map("revoked_by")
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Tin Discord chứa highlight (kênh + id tin); luôn ghi/xoá cùng nhau, cả hai null = không có highlight.
  highlightChannelId String? @map("highlight_channel_id")
  highlightMessageId String? @map("highlight_message_id")

  member     Member       @relation("ReportMember", fields: [memberId], references: [id])
  role       Role         @relation(fields: [roleId], references: [id])
  session    GameSession? @relation(fields: [sessionId], references: [id])
  reviewedBy Member?      @relation("ReportReviewer", fields: [reviewedById], references: [id])
  revokedBy  Member?      @relation("ReportRevoker", fields: [revokedById], references: [id])
  /// Báo cáo người chơi kèm lần khai này (của chính người khai), nếu có.
  accusation PlayerAccusation? @relation("AccusationReport")
  /// Báo cáo mà lần khai này là mục trừ điểm của nó (`source = accusation`).
  penaltyFor PlayerAccusation? @relation("AccusationPenaltyReport")

  @@index([roleId, status, playedOn])
  @@index([memberId, createdAt])
  @@map("stat_reports")
}

/// Báo cáo người chơi (spec điểm role §4, §6): người khai `reporter` báo `accused` (đang chơi
/// `accusedRole`) đã bắn `victim` thuộc `victimFaction` trong ngày `playedOn` (= ngày chơi của lần khai
/// `report`). Duyệt đúng → `report.bonusPoints = 1`, tạo lần khai trừ điểm `penaltyReport`
/// (`source = accusation`); báo cáo trùng cùng vụ (accused, role, victim, playedOn) còn `pending` →
/// `superseded`. CHECK: `accused_id <> reporter_id`, `victim_id <> accused_id`. Báo cáo độc lập (spec
/// 2026-10-31 §B, `reportId` null) không có lần khai: duyệt đúng → +1 vào Tổng "Cả 3 phe" của người gửi
/// (không qua `bonusPoints`). CHECK: ghi chú ≤ 300; `revoked` có đủ người huỷ, giờ huỷ, lý do.
model PlayerAccusation {
  id              Int              @id @default(autoincrement())
  /// Lần khai chứa báo cáo (báo cáo cũ gửi kèm lần khai); null = báo cáo độc lập (tab "Báo cáo người chơi").
  reportId        Int?             @unique @map("report_id")
  reporterId      Int              @map("reporter_id")
  accusedId       Int              @map("accused_id")
  accusedRoleId   Int              @map("accused_role_id")
  victimId        Int              @map("victim_id")
  victimFaction   Faction          @map("victim_faction")
  playedOn        DateTime         @map("played_on") @db.Date
  status          AccusationStatus @default(pending)
  rejectReason    String?          @map("reject_reason")
  penaltyReportId Int?             @unique @map("penalty_report_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedById    Int?             @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  /// Chỉ báo cáo độc lập: buổi chơi (không bắt buộc, cùng ngày VN với `playedOn`) và ghi chú ≤ 300 ký tự.
  sessionId       Int?             @map("session_id")
  note            String?
  revokedById     Int?             @map("revoked_by")
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(3)

  report        StatReport?  @relation("AccusationReport", fields: [reportId], references: [id], onDelete: Restrict)
  reporter      Member      @relation("AccusationReporter", fields: [reporterId], references: [id])
  accused       Member      @relation("AccusationAccused", fields: [accusedId], references: [id])
  accusedRole   Role        @relation(fields: [accusedRoleId], references: [id])
  victim        Member      @relation("AccusationVictim", fields: [victimId], references: [id])
  penaltyReport StatReport? @relation("AccusationPenaltyReport", fields: [penaltyReportId], references: [id])
  reviewedBy    Member?     @relation("AccusationReviewer", fields: [reviewedById], references: [id])
  session       GameSession? @relation(fields: [sessionId], references: [id])
  revokedBy     Member?     @relation("AccusationRevoker", fields: [revokedById], references: [id])

  @@index([accusedId, accusedRoleId, victimId, playedOn, status])
  @@index([reporterId, createdAt])
  @@index([status, playedOn])
  @@map("player_accusations")
}

/// Mục treo thưởng (spec treo thưởng §3): `sessionId` null = áp dụng mọi buổi; `roleId` null = không
/// gắn role (điểm chỉ vào Tổng "Cả 3 phe"). CHECK: tên 1–80 ký tự, mô tả ≤ 200, điểm 1–50. Mục đã có
/// lần nhận không xoá được (khoá ngoại RESTRICT từ `bounty_claims`) — chỉ tắt.
model Bounty {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  points      Int
  roleId      Int?     @map("role_id")
  sessionId   Int?     @map("session_id")
  active      Boolean  @default(true)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  role      Role?         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  session   GameSession?  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy Member        @relation("BountyCreator", fields: [createdById], references: [id])
  claims    BountyClaim[]

  @@index([sessionId])
  @@map("bounties")
}

/// Một lần nhận treo thưởng. `roleId` và `points` chép từ mục lúc nhận — sửa mục sau đó không đổi
/// lần nhận đã có. `playedOn` = ngày VN của buổi (mùa tính theo ngày này). Mỗi (mục, người, buổi)
/// nhận một lần (UNIQUE) — bị từ chối cũng không nhận lại.
model BountyClaim {
  id           Int               @id @default(autoincrement())
  bountyId     Int               @map("bounty_id")
  memberId     Int               @map("member_id")
  sessionId    Int               @map("session_id")
  playedOn     DateTime          @map("played_on") @db.Date
  roleId       Int?              @map("role_id")
  points       Int
  status       BountyClaimStatus @default(pending)
  /// Lý do từ chối hoặc huỷ duyệt (bắt buộc ở cả hai trạng thái).
  rejectReason String?           @map("reject_reason")
  source       BountyClaimSource
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedById Int?              @map("reviewed_by")
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  revokedById  Int?              @map("revoked_by")
  revokedAt    DateTime?         @map("revoked_at") @db.Timestamptz(3)

  bounty     Bounty      @relation(fields: [bountyId], references: [id])
  member     Member      @relation("BountyClaimMember", fields: [memberId], references: [id])
  session    GameSession @relation(fields: [sessionId], references: [id])
  role       Role?       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  reviewedBy Member?     @relation("BountyClaimReviewer", fields: [reviewedById], references: [id])
  revokedBy  Member?     @relation("BountyClaimRevoker", fields: [revokedById], references: [id])

  @@unique([bountyId, memberId, sessionId])
  @@index([status, playedOn])
  @@index([memberId, playedOn])
  @@map("bounty_claims")
}

/// Ngày nhân điểm (spec ngày nhân điểm §2): điểm cộng của lần khai có `playedOn = day` được nhân
/// `multiplier` lúc tính (đọc hệ số hiện tại). CHECK: hệ số 2–5, lời nhắn ≤ 100 ký tự.
/// `announcedAt` null → bộ hẹn giờ đăng bù tin tạo; `remindedAt` = đã nhắc 9:00 đúng ngày.
model ScoreMultiplierDay {
  id          Int       @id @default(autoincrement())
  day         DateTime  @unique @db.Date
  multiplier  Int
  message     String?
  createdById Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  announcedAt DateTime? @map("announced_at") @db.Timestamptz(3)
  remindedAt  DateTime? @map("reminded_at") @db.Timestamptz(3)

  createdBy Member @relation(fields: [createdById], references: [id])

  @@map("score_multiplier_days")
}

model Season {
  id             String    @id // YYYY-MM
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  reviewNudgedAt DateTime? @map("review_nudged_at") @db.Timestamptz(3)
  /// Đã chốt nhưng chưa đăng được bảng tổng kết vào kênh thông báo — bộ hẹn giờ đăng bù.
  summaryPending Boolean   @default(false) @map("summary_pending")

  roleTitles RoleTitle[]

  @@map("seasons")
}

model RoleTitle {
  seasonId String @map("season_id")
  roleId   Int    @map("role_id")
  memberId Int    @map("member_id")
  score    Int

  season Season @relation(fields: [seasonId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@id([seasonId, roleId])
  @@map("role_titles")
}

// ---------------------------------------------------------------------------
// Huy hiệu (danh hiệu vĩnh viễn) — spec 2026-10-26-badges-design.md §5
// ---------------------------------------------------------------------------

/// Một danh hiệu đã trao. Chữ hiện (`title`, `icon`, `detail`) đóng băng lúc trao;
/// app không bao giờ sửa hay xoá dòng này (danh hiệu không mất).
model MemberBadge {
  id        Int      @id @default(autoincrement())
  memberId  Int      @map("member_id")
  /// Khoá trong danh mục `src/shared/badges.ts` (vd `smvp`, `games_50`).
  badgeKey  String   @map("badge_key")
  /// `YYYY-MM` với danh hiệu tháng; `''` với cột mốc.
  periodId  String   @map("period_id")
  title     String
  icon      String
  detail    String
  awardedAt DateTime @map("awarded_at") @db.Timestamptz(3)

  member Member @relation(fields: [memberId], references: [id])

  @@unique([badgeKey, periodId, memberId])
  @@index([awardedAt, id])
  @@index([memberId, awardedAt])
  @@map("member_badges")
}

/// Tháng (`YYYY-MM`) đã trao danh hiệu xong — chốt chặn để không trao trùng khi chạy lại hay chạy song song.
model BadgeMonth {
  periodId  String   @id @map("period_id")
  awardedAt DateTime @map("awarded_at") @db.Timestamptz(3)
  /// Đã trao nhưng chưa đăng được tin tổng kết vào kênh thông báo — lượt sau đăng bù.
  announcePending Boolean @map("announce_pending")

  @@map("badge_months")
}

// ---------------------------------------------------------------------------
// Cài đặt và bộ hẹn giờ
// ---------------------------------------------------------------------------

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model SchedulerLease {
  id        Int      @id
  holder    String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("scheduler_lease")
}
