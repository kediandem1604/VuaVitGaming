{
  "name": "ggd-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build --config src/web/vite.config.ts",
    "start": "prisma migrate deploy && node dist/server/seed/run.js && node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "db:start": "docker compose up -d --wait --wait-timeout 120 db",
    "db:stop": "docker compose stop db db-test",
    "db:start:embedded": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/server/seed/run.ts",
    "db:demo": "tsx scripts/demo-data.ts",
    "app:docker": "docker compose --profile app up --build app"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.5",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/async-exit-hook": "^2.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "async-exit-hook": "^2.0.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
